<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-brand" href="/" aria-label="Alex Smith — home">
      <img src="/images/Logo-UpMrd.svg" alt="Alex Smith" width="120" height="27">
    </a>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary">
      <ul class="primary-nav__list">
        <% navLinks.forEach((link) => { %>
          <li>
            <a
              class="primary-nav__link<%= activeNav === link.label ? ' is-active' : '' %>"
              href="<%= link.href %>"
              <%= activeNav === link.label ? 'aria-current="page"' : '' %>
            ><%= link.label %></a>
          </li>
        <% }) %>
      </ul>
      <a class="btn nav-cta-mobile" href="/contact">
        Book Now
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </a>
    </nav>

    <div class="site-header__actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.42 1.42"/></svg>
      </button>

      <a class="btn btn--nav nav-cta" href="/contact">
        Book Now
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </a>
    </div>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open menu"
      data-nav-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>
