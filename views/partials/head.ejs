<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#024768">
    <title><%= pageTitle || site.title %></title>
    <meta name="description" content="<%= pageDescription || site.description %>">
    <link rel="icon" type="image/svg+xml" href="/images/favIcon-Z0xVu.svg">
    <link rel="preload" href="/fonts/albert-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    <script>
      (() => {
        let theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        try {
          const stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") theme = stored;
        } catch (error) {
          /* Keep the system preference when storage is unavailable. */
        }

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <link rel="stylesheet" href="/css/style.css">
    <script>document.documentElement.classList.add("js");</script>
  </head>
  <body class="<%= bodyClass || '' %>">
    <a class="skip-link" href="#main-content">Skip to content</a>
