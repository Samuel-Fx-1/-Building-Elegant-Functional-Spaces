<section class="section section--beige about-studio" aria-labelledby="about-studio-title">
  <div class="container about-studio__grid">
    <div class="about-studio__copy" data-reveal>
      <h2 id="about-studio-title"><%= about.title %></h2>
      <p class="about-studio__text"><%= about.text %></p>

      <div class="stats">
        <% about.stats.forEach((stat) => { %>
          <a class="stat" href="<%= stat.href %>">
            <span class="stat__value"><%= stat.value %></span>
            <span class="stat__label"><%= stat.label %></span>
          </a>
        <% }) %>
      </div>
    </div>

    <div class="about-studio__media" data-reveal style="--reveal-delay: 120ms">
      <img src="<%= about.image %>" alt="Architect working on a solar roof installation" width="828" height="812" loading="lazy">
      <a class="call-chip" href="tel:+18801000000000" aria-label="Call Now">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
        Call Now
      </a>
    </div>
  </div>
</section>

<section class="logo-strip" aria-label="Trusted partners and brands">
  <div class="logo-strip__track">
    <% for (let i = 0; i < 4; i++) { %>
      <img src="/images/Sliderlogo-G_Zst.png" alt="<%= i === 0 ? 'Partner brand logos' : '' %>" width="2160" height="210" loading="lazy">
    <% } %>
  </div>
</section>
