<section class="section section--dark testimonials" aria-labelledby="testimonials-title">
  <div class="container testimonials__grid">
    <div class="testimonials__intro" data-reveal>
      <h2 id="testimonials-title">Trusted by<br>Homeowners &amp;<br>investors</h2>
      <p>Our projects blend design, quality, and purpose—crafted to elevate everyday living.</p>
      <a class="btn" href="/contact">
        Contact Me
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </a>
    </div>

    <div class="testimonials__list">
      <% testimonials.forEach((testimonial, index) => { %>
        <article class="testimonial-card" data-reveal style="--reveal-delay: <%= index * 90 %>ms">
          <div class="testimonial-card__quote">
            <img class="testimonial-card__mark" src="/images/coma-dtHCB.svg" alt="" width="36" height="26" loading="lazy">
            <p><%= testimonial.quote %></p>
          </div>
          <div class="testimonial-card__author">
            <img class="testimonial-card__avatar" src="<%= testimonial.avatar %>" alt="" width="48" height="48" loading="lazy">
            <div class="testimonial-card__meta">
              <p class="testimonial-card__name"><%= testimonial.name %></p>
              <img class="testimonial-card__stars" src="/images/star-2Ouly.svg" alt="Rated 5 out of 5 stars" width="119" height="24" loading="lazy">
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
