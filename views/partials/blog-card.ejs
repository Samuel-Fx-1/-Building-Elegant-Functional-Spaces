<article class="blog-card" data-reveal>
  <a class="blog-card__media" href="/blog/<%= post.slug %>" tabindex="-1" aria-hidden="true">
    <img src="<%= post.image %>" alt="" width="537" height="380" loading="lazy">
  </a>
  <div class="blog-card__body">
    <p class="blog-card__date"><%= post.date %></p>
    <h3 class="blog-card__title">
      <a href="/blog/<%= post.slug %>"><%= post.title %></a>
    </h3>
    <p class="blog-card__text"><%= post.excerpt %></p>
    <a class="btn" href="/blog/<%= post.slug %>">
      Read More
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
    </a>
  </div>
</article>
